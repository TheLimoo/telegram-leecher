# Telegram Leecher Bot — Environment Variables

# === Required ===
BOT_TOKEN=your_bot_token_from_botfather

# === Optional: Access Control ===
# Comma-separated Telegram user IDs. Empty = open to all.
ALLOWED_USERS=

# === Optional: Self-Hosted Bot API (removes 50MB limit) ===
# Get these from https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# Leave LOCAL_API_URL empty to use standard api.telegram.org (50MB limit)
LOCAL_API_URL=http://127.0.0.1:8081

# === Optional: Download Settings ===
# MAX_FILE_SIZE=2147483648
# DOWNLOAD_DIR=/tmp/downloads
# DOWNLOAD_TIMEOUT=300
# MAX_CONCURRENT=3

# === Optional: Deployment ===
# WEBHOOK_URL=https://your-app.onrender.com
# PORT=8443
# AUTO_CLEANUP=true
